# Optional ntfy notification target.
DN42LANDING_NTFY_URL=http://127.0.0.1:5197/dn42-peering

# Optional bearer token if your ntfy endpoint requires one.
DN42LANDING_NTFY_TOKEN=

# Listener defaults are already the planned DN42 service addresses.
# DN42LANDING_IPV4_LISTEN=172.20.220.50:80
# DN42LANDING_IPV6_LISTEN=[fdf0:e12c:5528::10]:80

# DN42LANDING_DB=/var/lib/dn42landing/peering.db
# DN42LANDING_RATE_LIMIT=60s
